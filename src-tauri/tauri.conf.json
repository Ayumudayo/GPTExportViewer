{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPTExportManager",
  "version": "0.1.0",
  "identifier": "local.gpt-export-manager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GPTExportManager",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "minimumWebview2Version": "110.0.1531.0"
    }
  }
}
